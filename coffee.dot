digraph G {
  graph [rankdir=TB, fontname="Helvetica", fontsize=13, pad=0.4, nodesep=0.35, ranksep=0.42, bgcolor="white",
         label="Bright Coffee Shop: Sales EDA & Dashboard, project flow", labelloc=t, fontcolor="#1F4E79"];
  node  [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#EAF1F8", color="#1F4E79", margin="0.2,0.08"];
  edge  [fontname="Helvetica", fontsize=10, color="#555555", arrowsize=0.7];

  start [label="Start\nBright_Coffee_Shop_Sales.csv\n149,116 transactions, Jan-Jun 2023", shape=oval, fillcolor="#1F4E79", fontcolor="white"];
  load  [label="1. Load\nRead ';'-delimited CSV with PySpark\nFix comma decimal in unit_price (3,1 to 3.1)"];
  nulls [label="2. Null values in any column?", shape=diamond, style="filled", fillcolor="#FFF4DC", margin="0.05,0.02"];
  nullY [label="Decide: drop, impute or flag\n(none found in this dataset)"];
  dups  [label="3. Duplicate transaction_id?", shape=diamond, style="filled", fillcolor="#FFF4DC", margin="0.05,0.02"];
  dupY  [label="Remove duplicate rows\n(none found in this dataset)"];
  clean [label="4. Clean & engineer features\nCast types, parse date and time\nrevenue = transaction_qty × unit_price\nAdd month, day_of_week, hour_of_day, is_weekend"];
  desc  [label="5. Descriptive statistics\nSummary of quantity, price and revenue"];
  agg   [label="6. Aggregate and chart\nKPIs · daily and monthly trend · category\ntop 10 products · hour · weekday · store · order value"];
  dash  [label="7. Dashboard\nPin charts to Databricks dashboard\nBuild Lovable dashboard", fillcolor="#E2F0D9", color="#5B8C3A"];
  slides[label="8. Static charts for slides\nMatplotlib: monthly trend, category, peak hours"];
  ins   [label="9. Insights & recommendations\nTop category, product, hour, store and month\nStaffing at 10:00 peak, bundles, store benchmarking"];
  out   [label="Outputs\nNotebook · Lovable dashboard · 10-slide presentation · README", shape=oval, fillcolor="#1F4E79", fontcolor="white"];

  start -> load -> nulls;
  nulls -> nullY [label="yes"]; nullY -> dups;
  nulls -> dups [label="no"];
  dups -> dupY [label="yes"]; dupY -> clean;
  dups -> clean [label="no"];
  clean -> desc -> agg -> dash;
  agg -> slides;
  dash -> ins; slides -> ins;
  ins -> out;
  {rank=same; nullY; nulls}
  {rank=same; dupY; dups}
}
